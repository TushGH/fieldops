# Copy to .env and set a password generated locally. Never commit .env.
POSTGRES_DB=fieldops
POSTGRES_USER=fieldops
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Keep this URL aligned with POSTGRES_DB and POSTGRES_PORT above.
DATABASE_URL=jdbc:postgresql://localhost:5432/fieldops
API_PORT=8080
# Local HTTP only. Keep true for HTTPS deployments.
SESSION_COOKIE_SECURE=false
# Configure a local SMTP inbox or a real provider before using registration.
WEB_ORIGIN=http://127.0.0.1:3000
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=fieldops@localhost
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
# Restricted operator environments only, until stronger authentication is implemented.
PLATFORM_ENABLED=false
