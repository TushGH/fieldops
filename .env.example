# Copy to .env and set a password generated locally. Never commit .env.
POSTGRES_DB=fieldops
POSTGRES_USER=fieldops
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Keep this URL aligned with POSTGRES_DB and POSTGRES_PORT above.
DATABASE_URL=jdbc:postgresql://localhost:5432/fieldops
API_PORT=8080
# Local HTTP only. Keep true for HTTPS deployments.
SESSION_COOKIE_SECURE=false
